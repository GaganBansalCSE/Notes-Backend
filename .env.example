NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notes_db?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-char-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=10
MAX_BODY_SIZE=100kb
